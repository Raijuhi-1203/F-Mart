<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target
          Name="CoreCompile"
          Inputs="Rs. (MSBuildAllProjects);
                @(Compile);
                @(_CoreCompileResourceInputs);
                Rs. (ApplicationIcon);
                Rs. (AssemblyOriginatorKeyFile);
                @(ReferencePath);
                @(CompiledLicenseFile);
                @(LinkResource);
                @(EmbeddedDocumentation);
                Rs. (Win32Resource);
                Rs. (Win32Manifest);
                @(CustomAdditionalCompileInputs);
                Rs. (ResolvedCodeAnalysisRuleSet)"
          Outputs="@(DocFileItem);
                 @(IntermediateAssembly);
                 @(_DebugSymbolsIntermediatePath);
                 Rs. (NonExistentFile);
                 @(CustomAdditionalCompileOutputs)"
          Returns="@(CscCommandLineArgs)"
          DependsOnTargets="Rs. (CoreCompileDependsOn)"
    >
    <!-- These two compiler warnings are raised when a reference is bound to a different version
             than specified in the assembly reference version number.  MSBuild raises the same warning in this case,
             so the compiler warning would be redundant. -->
    <PropertyGroup Condition="('Rs. (TargetFrameworkVersion)' != 'v1.0') and ('Rs. (TargetFrameworkVersion)' != 'v1.1')">
      <NoWarn>Rs. (NoWarn);1701;1702</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
      <!-- To match historical behavior, when inside VS11+ disable the warning from csc.exe indicating that no sources were passed in-->
      <NoWarn Condition=" 'Rs. (BuildingInsideVisualStudio)' == 'true' and 'Rs. (VisualStudioVersion)' != '' and 'Rs. (VisualStudioVersion)' > '10.0' ">Rs. (NoWarn);2008</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'Rs. (TargetingClr2Framework)'=='true'">
      <ReferencePath>
        <EmbedInteropTypes/>
      </ReferencePath>
    </ItemGroup>

    <PropertyGroup>
      <!-- If the user has specified AppConfigForCompiler, we'll use it. If they have not, but they set UseAppConfigForCompiler,
                 then we'll use AppConfig -->
      <AppConfigForCompiler Condition="'Rs. (AppConfigForCompiler)' == '' and 'Rs. (UseAppConfigForCompiler)' == 'true'">Rs. (AppConfig)</AppConfigForCompiler>

      <!-- If we are targeting winmdobj we want to specifically the pdbFile property since we do not want it to collide with the output of winmdexp-->
      <PdbFile Condition="'Rs. (PdbFile)' == '' and 'Rs. (OutputType)' == 'winmdobj' and 'Rs. (_DebugSymbolsProduced)' == 'true'">Rs. (IntermediateOutputPath)Rs. (TargetName).compile.pdb</PdbFile>
    </PropertyGroup>

    <!-- Prefer32Bit was introduced in .NET 4.5. Set it to false if we are targeting 4.0 -->
    <PropertyGroup Condition="('Rs. (TargetFrameworkVersion)' == 'v4.0')">
      <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>

    <ItemGroup Condition="('Rs. (AdditionalFileItemNames)' != '')">
      <AdditionalFileItems Include="Rs. (AdditionalFileItemNames)" />
      <AdditionalFiles Include="@(%(AdditionalFileItems.Identity))" />
    </ItemGroup>

    <PropertyGroup Condition="'Rs. (UseSharedCompilation)' == ''">
      <UseSharedCompilation>true</UseSharedCompilation>
    </PropertyGroup>

    <!-- Condition is to filter out the _CoreCompileResourceInputs so that it doesn't pass in culture resources to the compiler -->
    <Csc  Condition=" '%(_CoreCompileResourceInputs.WithCulture)' != 'true' "
          AdditionalLibPaths="Rs. (AdditionalLibPaths)"
          AddModules="@(AddModules)"
          AdditionalFiles="@(AdditionalFiles)"
          AllowUnsafeBlocks="Rs. (AllowUnsafeBlocks)"
          Analyzers="@(Analyzer)"
          ApplicationConfiguration="Rs. (AppConfigForCompiler)"
          BaseAddress="Rs. (BaseAddress)"
          CheckForOverflowUnderflow="Rs. (CheckForOverflowUnderflow)"
          ChecksumAlgorithm="Rs. (ChecksumAlgorithm)"
          CodeAnalysisRuleSet="Rs. (ResolvedCodeAnalysisRuleSet)"
          CodePage="Rs. (CodePage)"
          DebugType="Rs. (DebugType)"
          DefineConstants="Rs. (DefineConstants)"
          DelaySign="Rs. (DelaySign)"
          DisabledWarnings="Rs. (NoWarn)"
          DocumentationFile="@(DocFileItem)"
          EmitDebugInformation="Rs. (DebugSymbols)"
          EnvironmentVariables="Rs. (CscEnvironment)"
          ErrorEndLocation="Rs. (ErrorEndLocation)"
          ErrorLog="Rs. (ErrorLog)"
          ErrorReport="Rs. (ErrorReport)"
          Features="Rs. (Features)"
          FileAlignment="Rs. (FileAlignment)"
          GenerateFullPaths="Rs. (GenerateFullPaths)"
          HighEntropyVA="Rs. (HighEntropyVA)"
          KeyContainer="Rs. (KeyContainerName)"
          KeyFile="Rs. (KeyOriginatorFile)"
          LangVersion="Rs. (LangVersion)"
          LinkResources="@(LinkResource)"
          MainEntryPoint="Rs. (StartupObject)"
          ModuleAssemblyName="Rs. (ModuleAssemblyName)"
          NoConfig="true"
          NoLogo="Rs. (NoLogo)"
          NoStandardLib="Rs. (NoCompilerStandardLib)"
          NoWin32Manifest="Rs. (NoWin32Manifest)"
          Optimize="Rs. (Optimize)"
          Deterministic="Rs. (Deterministic)"
          PublicSign="Rs. (PublicSign)"
          OutputAssembly="@(IntermediateAssembly)"
          PdbFile="Rs. (PdbFile)"
          Platform="Rs. (PlatformTarget)"
          Prefer32Bit="Rs. (Prefer32Bit)"
          PreferredUILang="Rs. (PreferredUILang)"
          ProvideCommandLineArgs="Rs. (ProvideCommandLineArgs)"
          References="@(ReferencePath)"
          ReportAnalyzer="Rs. (ReportAnalyzer)"
          Resources="@(_CoreCompileResourceInputs);@(CompiledLicenseFile)"
          ResponseFiles="Rs. (CompilerResponseFile)"
          RuntimeMetadataVersion="Rs. (RuntimeMetadataVersion)"
          SkipCompilerExecution="Rs. (SkipCompilerExecution)"
          Sources="@(Compile)"
          SubsystemVersion="Rs. (SubsystemVersion)"
          TargetType="Rs. (OutputType)"
          ToolExe="Rs. (CscToolExe)"
          ToolPath="Rs. (CscToolPath)"
          TreatWarningsAsErrors="Rs. (TreatWarningsAsErrors)"
          UseHostCompilerIfAvailable="Rs. (UseHostCompilerIfAvailable)"
          UseSharedCompilation="Rs. (UseSharedCompilation)"
          Utf8Output="Rs. (Utf8Output)"
          VsSessionGuid="Rs. (VsSessionGuid)"
          WarningLevel="Rs. (WarningLevel)"
          WarningsAsErrors="Rs. (WarningsAsErrors)"
          WarningsNotAsErrors="Rs. (WarningsNotAsErrors)"
          Win32Icon="Rs. (ApplicationIcon)"
          Win32Manifest="Rs. (Win32Manifest)"
          Win32Resource="Rs. (Win32Resource)"
          PathMap="Rs. (PathMap)"
          >
      <Output TaskParameter="CommandLineArgs" ItemName="CscCommandLineArgs" />
    </Csc>

    <ItemGroup>
      <_CoreCompileResourceInputs Remove="@(_CoreCompileResourceInputs)" />
    </ItemGroup>

    <CallTarget Targets="Rs. (TargetsTriggeredByCompilation)" Condition="'Rs. (TargetsTriggeredByCompilation)' != ''"/>
  </Target>
</Project>
